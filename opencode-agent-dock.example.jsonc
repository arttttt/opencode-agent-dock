// opencode-agent-dock — TUI plugin.
//
// TUI plugins are configured in tui.json (NOT opencode.json). Merge this entry
// into ~/.config/opencode/tui.json (user) or .opencode/tui.json (project),
// then restart OpenCode.
{
  "$schema": "https://opencode.ai/tui.json",
  "plugin": ["opencode-agent-dock"]

  // local development (file plugin, no npm):
  // "plugin": [["file:///Users/you/Projects/opencode-agent-dock/src/index.tsx"]]

  // remap the focus toggle to another key if you like:
  // "keybinds": { "agent-dock.toggle": "<leader>d" }
}
