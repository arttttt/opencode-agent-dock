{
  "name": "opencode-agent-dock",
  "version": "1.0.1",
  "description": "OpenCode TUI plugin — a Claude-Code-style bottom panel of running subagents with inline keyboard navigation.",
  "type": "module",
  "exports": {
    "./tui": {
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "prepack": "npm run build",
    "pretest": "npm run build",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write \"src/**/*.{ts,tsx}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx}\""
  },
  "keywords": [
    "opencode",
    "opencode-plugin",
    "tui",
    "subagent",
    "agents",
    "panel",
    "dock"
  ],
  "author": "Artem Bambalov <artem-bambalov@yandex.ru>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/arttttt/opencode-agent-dock.git"
  },
  "homepage": "https://github.com/arttttt/opencode-agent-dock#readme",
  "bugs": {
    "url": "https://github.com/arttttt/opencode-agent-dock/issues"
  },
  "peerDependencies": {
    "@opencode-ai/plugin": ">=1.18.0",
    "@opencode-ai/sdk": ">=1.18.0",
    "@opentui/solid": ">=0.4.5"
  },
  "peerDependenciesMeta": {
    "@opentui/solid": {
      "optional": true
    }
  },
  "devDependencies": {
    "@babel/core": "7.28.0",
    "@babel/preset-typescript": "7.27.1",
    "@opencode-ai/plugin": "^1.18.4",
    "@opencode-ai/sdk": "^1.18.4",
    "@opentui/core": ">=0.4.5",
    "@opentui/solid": ">=0.4.5",
    "@types/bun": "latest",
    "babel-preset-solid": "1.9.12",
    "bun": "^1.4.4",
    "prettier": "^3.8.1",
    "solid-js": "^1.9.0",
    "typescript": "^5.7.0",
    "vitest": "^2.1.0"
  },
  "engines": {
    "opencode": "^1.18.0"
  }
}
